---
import { SOCIALS } from "@/constants";

export interface Props {
  centered?: boolean;
}

const { centered = false } = Astro.props;
---

<div class:list={["flex-wrap justify-center gap-1", { flex: centered }]}>
  {
    SOCIALS.map(social => (
      <button
        class="sm:p-1 focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent theme-switcher"
        title={social.linkTitle}
        aria-label="auto"
        aria-live="polite"
        onclick={`window.open("${social.href}", "_blank")`}
      >
        <social.icon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
        <span class="sr-only">{social.linkTitle}</span>
      </button>
    ))
  }
</div>
