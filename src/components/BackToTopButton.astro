---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
---

<div
  id="btt-btn-container"
>
  <a
    data-button="back-to-top"
    href="#"
    class="inline-flex items-center gap-1 text-accent hover:underline focus-visible:underline"
    title="Back to top"
  >
    <IconArrowNarrowUp class="inline-block size-5 rtl:rotate-180" />
    <span>Back To Top</span>
  </a>
</div>

<script is:inline>
  /** Scrolls to the top when the "Back to Top" button is clicked. */
  const backToTopBtn = document.querySelector("[data-button='back-to-top']");
  if (backToTopBtn) {
    backToTopBtn.addEventListener("click", (e) => {
      e.preventDefault();
      document.body.scrollTop = 0; // For Safari
      document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    });
  }
</script>
