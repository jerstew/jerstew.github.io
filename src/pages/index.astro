---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <div class="page-container">
    <header>
      <span class="header-logo">
        <a href="/">JS</a>
      </span>
      <nav>
        <a href="/posts">Posts</a>
        <a href="/about">About</a>
      </nav>
    </header>
    <div class="wrapper">
      <main id="main-content" data-layout="index" class="index-content">
        <div class="intro-box">
          <h1>Hello, I'm Jeremy Stewart</h1>
          <p>Full-stack software engineer building practical, reliable web applications.<br/>
            I share thoughts on development, tech, and tools here.</p>
        </div>

        {
          recentPosts.length > 0 && (
            <div class="section">
              <h2>Recent Posts</h2>
              <ul class="posts">
                {recentPosts.map(
                  (data, index) =>
                    index < SITE.postPerIndex && <Card variant="h3" {...data} />
                )}
              </ul>
            </div>
          )
        }
      </main>
      <Footer />
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
